# =============================================================
# NexaSupport AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.
# =============================================================

# ── LLM Provider ──────────────────────────────────────────────
# Choose: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional — only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# ── LLM Model Settings ────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Embedding Settings ────────────────────────────────────────
# 'local' uses sentence-transformers (free, runs on your machine)
# 'gemini' uses Google's embedding API (requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Database ───────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=it_knowledge_base

# ── Relational Database ───────────────────────────────────────
# SQLite for development (no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./data/nexasupport.db

# For PostgreSQL in production, use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexasupport

# ── RAG Settings ──────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.4
CONFIDENCE_THRESHOLD=0.70

# ── Chunking Settings ─────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Application Settings ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
APP_NAME=NexaSupport AI
COMPANY_NAME=Acme Corp
